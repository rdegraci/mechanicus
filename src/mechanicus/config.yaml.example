# Settings for Mechanicus.
# On first start this file is copied to
# ~/Library/Application Support/mechanicus/config.yaml.
# Later edits of that copy are kept.

model: gpt-4o
reasoning_effort: medium
repair_attempts: 3
jev_model: jev-1.14.0
# Relative to the startup directory. Empty means write .py and .module
# files at the startup directory. Self-host example: src/mechanicus
package_root: ""
